# 复制本文件为 .env.local 后再填写真实值：
# cp .env.example .env.local
# .env.local 已被 .gitignore 排除，不会进入 Git。

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# 生产 Profile 需要显式提供数据库连接。本作业默认继续使用本地 H2 文件数据库。
DATABASE_URL=jdbc:h2:file:./data/ops-alert-assistant-prod
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# 主模型：DeepSeek 的 OpenAI 兼容接口。
AI_PRIMARY_PROVIDER=deepseek
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat

# 备用模型：阿里百炼的 OpenAI 兼容接口。
AI_BACKUP_PROVIDER=bailian
AI_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BAILIAN_API_KEY=
AI_BAILIAN_MODEL=qwen-plus
